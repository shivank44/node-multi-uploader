# =========================================================
# node-multi-uploader — Environment Variables
# =========================================================
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# NEVER commit your `.env` file to version control.
# =========================================================

# ---------------------------------------------------------
# 🎯 Active Provider
# ---------------------------------------------------------
# Which storage backend to use.
# Options: local | gcs | s3
STORAGE_PROVIDER=local


# =========================================================
# 🗂️ LOCAL FILESYSTEM PROVIDER
# =========================================================
# Only required when STORAGE_PROVIDER=local

# Directory where uploaded files will be written (relative or absolute).
UPLOAD_DIR=./uploads

# Public base URL used to build file URLs.
# e.g. http://localhost:3000/uploads
LOCAL_PUBLIC_URL=http://localhost:3000/uploads


# =========================================================
# ☁️ GOOGLE CLOUD STORAGE (GCS) PROVIDER
# =========================================================
# Only required when STORAGE_PROVIDER=gcs
#
# Setup guide:
#   1. Create a service account in GCP Console
#   2. Grant it "Storage Object Admin" on your bucket
#   3. Download the JSON key file
#   4. Point GCS_KEY_FILE to its absolute or relative path

GCS_PROJECT_ID=my-gcp-project-id
GCS_BUCKET=my-gcs-bucket-name
GCS_KEY_FILE=./secrets/gcs-service-account.json

# Optional: path prefix inside the bucket (e.g. "prod/uploads")
GCS_PREFIX=uploads


# =========================================================
# 🪣 AWS S3 PROVIDER
# =========================================================
# Only required when STORAGE_PROVIDER=s3
#
# Best practice: use an IAM user with least-privilege access,
# scoped ONLY to the specific bucket and actions you need:
#   s3:PutObject, s3:GetObject, s3:DeleteObject

AWS_REGION=us-east-1
AWS_BUCKET=my-s3-bucket-name
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: for S3-compatible services (MinIO, DigitalOcean Spaces, R2, LocalStack)
# Leave blank to use real AWS.
# AWS_ENDPOINT=http://localhost:4566
# AWS_FORCE_PATH_STYLE=true

# Optional: path prefix inside the bucket (e.g. "prod/uploads")
S3_PREFIX=uploads


# =========================================================
# 🖥️ SERVER (for the Express example)
# =========================================================
PORT=3000
NODE_ENV=development


# =========================================================
# 🧪 TESTING (integration tests only)
# =========================================================
# Used by the test suite to spin up emulators.
# LocalStack for S3, Fake GCS Server for GCS.

LOCALSTACK_ENDPOINT=http://localhost:4566
FAKE_GCS_ENDPOINT=http://localhost:4443

# Buckets used exclusively during tests (safe to delete afterwards)
TEST_S3_BUCKET=multi-uploader-test
TEST_GCS_BUCKET=multi-uploader-test
# =========================================================
# Dependencies
# =========================================================
node_modules/
jspm_packages/
bower_components/

# =========================================================
# Lockfiles
# ---------------------------------------------------------
# For a published library, lockfiles are typically ignored
# since consumers resolve their own dependency tree.
# If you rely on exact CI reproducibility, you may want to
# commit package-lock.json instead — remove it from here.
# =========================================================
package-lock.json
yarn.lock
pnpm-lock.yaml

# =========================================================
# Environment & Secrets — NEVER COMMIT THESE
# =========================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/
gcs-service-account.json
aws-credentials

# =========================================================
# Build & Distribution Output
# =========================================================
dist/
build/
out/
lib/
*.tsbuildinfo

# =========================================================
# Test Coverage & Reports
# =========================================================
coverage/
.nyc_output/
junit.xml
test-results/

# =========================================================
# Runtime Data (from the local adapter)
# =========================================================
uploads/
tmp/
temp/
.cache/

# =========================================================
# Logs
# =========================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================
# Node.js / Editor / OS
# =========================================================
.npm/
.eslintcache
.node_repl_history
*.tgz

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# =========================================================
# Docker (for local emulators)
# =========================================================
.docker/
docker-compose.override.yml